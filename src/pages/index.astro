---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import About from '../components/landing/About.astro';
import Experience from '../components/landing/Experience.astro';
import Education from '../components/landing/Education.astro';
import Skills from '../components/landing/Skills.astro';
import Courses from '../components/landing/Courses.astro';
import Projects from '../components/landing/Projects.astro';
import Contact from '../components/landing/Contact.astro';
import Footer from '../components/layout/Footer.astro';
import { siteData } from '../data/siteData';

const { cv, hero } = siteData;
---

<Layout title={`${hero.title} | ${hero.kicker.es}`}>
  <Navbar />
  
  <main>
    <Hero />
    <About />
    <Experience />
    <Education />
    <Skills />
    <Courses />
    <Projects />
    
    <!-- CV Section -->
    <section id="cv" class="section cv-section" data-section>
      <div class="container text-center">
        <h2 class="section-title" id="cv-title">{cv.title.es}</h2>
        <p class="section-intro" id="cv-subtitle">{cv.subtitle.es}</p>
        <a href={cv.path} download class="resume-btn" id="cv-btn">
          {cv.buttonText.es}
        </a>
      </div>
    </section>
    
    <Contact />
  </main>
  
  <Footer />
</Layout>

<style>
  .cv-section {
    background: linear-gradient(to bottom, transparent, rgba(47, 133, 90, 0.05));
  }
  .text-center { 
    text-align: center; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    gap: 1.5rem;
  }
  .resume-btn {
    display: inline-block;
    padding: 1rem 3rem;
    background: var(--agro-green);
    color: #fff;
    font-weight: 700;
    font-size: 1.2rem;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(47, 133, 90, 0.3);
    transition: all 0.3s ease;
  }
  .resume-btn:hover {
    transform: translateY(-5px);
    background: var(--agro-accent);
    box-shadow: 0 15px 40px rgba(47, 133, 90, 0.4);
  }
</style>

<script>
  import { $lang } from '../stores/langStore';
  import { siteData } from '../data/siteData';

  $lang.subscribe(lang => {
    const title = document.getElementById('cv-title');
    const subtitle = document.getElementById('cv-subtitle');
    const btn = document.getElementById('cv-btn');

    if (title) title.textContent = siteData.cv.title[lang];
    if (subtitle) subtitle.textContent = siteData.cv.subtitle[lang];
    if (btn) btn.textContent = siteData.cv.buttonText[lang];
  });
</script>
