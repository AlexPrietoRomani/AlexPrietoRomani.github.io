---
import '../styles/global.css';
import SensorNetwork from '../components/common/SensorNetwork.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio y Landing Page de Alex Prieto Romani" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Fonts: Outfit -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		
		<link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
		
		<!-- Open Graph / Social Media -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://alexprietoromani.github.io/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Portfolio y Landing Page de Alex Prieto Romani" />
		<meta property="og:image" content={new URL('/images/profile/profile.jpg', Astro.site)} />

		<title>{title}</title>
	</head>
	<body>
		<SensorNetwork />
		<div class="app-shell">
			<slot />
		</div>
	</body>
</html>
