---
import { siteData } from '../../data/siteData';

const { hero } = siteData;
---

<header class="nav-header">
  <nav class="nav-pill">
    <ul class="nav-list">
      <li><a href="#home" class="nav-item">Inicio</a></li>
      <li><a href="#experience" class="nav-item">Carrera</a></li>
      <li><a href="#projects" class="nav-item">Proyectos</a></li>
      <li><a href="#tech-stack" class="nav-item">Tech</a></li>
      <li><a href="#contact" class="nav-item">Contacto</a></li>
    </ul>
    
    <div class="nav-utils">
       <button class="lang-toggle" id="lang-toggle" aria-label="Cambiar idioma">
         <span data-lang="es" class="active">ES</span>
         <span class="separator">/</span>
         <span data-lang="en">EN</span>
       </button>
    </div>
  </nav>
</header>

<style>
  .nav-header {
    position: fixed;
    top: 1.5rem;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .nav-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem 1.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--nav-blur));
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    transition: all 0.3s ease;
  }

  .nav-item:hover {
    color: var(--agro-accent);
    background: rgba(72, 187, 120, 0.1);
  }

  .nav-item.active {
    color: var(--text-inverse);
    background: var(--agro-green);
  }

  .nav-utils {
    display: flex;
    align-items: center;
    border-left: 1px solid var(--glass-border);
    padding-left: 1rem;
  }

  .lang-toggle {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    transition: all 0.3s ease;
  }

  .lang-toggle:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.05);
  }

  .lang-toggle .active {
    color: var(--agro-accent);
  }

  .lang-toggle .separator {
    opacity: 0.3;
  }

  @media (max-width: 640px) {
    .nav-pill {
      gap: 0.5rem;
      padding: 0.4rem 1rem;
    }
    .nav-item {
      font-size: 0.8rem;
      padding: 0.4rem 0.5rem;
    }
    .nav-utils {
      display: none;
    }
  }
</style>

<script>
  import { $lang, toggleLang } from '../../stores/langStore';

  // Toggle Language Click
  const langToggle = document.getElementById('lang-toggle');
  if (langToggle) {
    langToggle.addEventListener('click', () => {
      toggleLang();
    });
  }

  // Update UI on Lang Change
  $lang.subscribe(lang => {
    // Update toggle buttons
    const spans = document.querySelectorAll('#lang-toggle span[data-lang]');
    spans.forEach(span => {
      span.classList.toggle('active', span.getAttribute('data-lang') === lang);
    });

    // Update navigation items text (simple translation for common items)
    const navItems = {
      es: ['Inicio', 'Carrera', 'Proyectos', 'Tech', 'Contacto'],
      en: ['Home', 'Career', 'Projects', 'Tech', 'Contact']
    } as any;
    
    document.querySelectorAll('.nav-item').forEach((item, index) => {
      item.textContent = navItems[lang][index];
    });

    // Dispatch event for other components to handle complex translations
    window.dispatchEvent(new CustomEvent('lang-changed', { detail: lang }));
  });

  // Scroll Spy
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.5
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        document.querySelectorAll('.nav-item').forEach(navItem => {
          const href = navItem.getAttribute('href');
          navItem.classList.toggle('active', href === `#${id}`);
        });
      }
    });
  }, observerOptions);

  document.querySelectorAll('section[id], main > div[id], [data-section]').forEach(section => {
    observer.observe(section);
  });
</script>
