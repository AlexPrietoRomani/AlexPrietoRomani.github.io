<div class="agro-bg-container">
  <canvas id="agro-canvas"></canvas>
  <div class="overlay"></div>
</div>

<style>
  .agro-bg-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: var(--bg-main);
    overflow: hidden;
  }

  #agro-canvas {
    display: block;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, var(--bg-main) 90%);
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('agro-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');

  let width = canvas.width = window.innerWidth;
  let height = canvas.height = window.innerHeight;

  const symbols = ['🌱', '💧', '🌿', '🧬', '📊', '🛰️', '🌾', '🚜', '📈'];
  const fontSize = 16;
  const columns = Math.floor(width / fontSize);
  
  const drops: number[] = [];
  for (let i = 0; i < columns; i++) {
    drops[i] = Math.random() * -100; // Random start positions
  }

  function draw() {
    // Fade effect
    ctx!.fillStyle = 'rgba(5, 10, 8, 0.1)'; // Match --bg-main with opacity
    ctx!.fillRect(0, 0, width, height);

    ctx!.fillStyle = '#2F855A'; // --agro-green
    ctx!.font = fontSize + 'px monospace';

    for (let i = 0; i < drops.length; i++) {
      const text = symbols[Math.floor(Math.random() * symbols.length)];
      ctx!.fillText(text, i * fontSize, Math.floor(drops[i]) * fontSize);

      if (Math.floor(drops[i]) * fontSize > height && Math.random() > 0.975) {
        drops[i] = 0;
      }

      drops[i] += 0.05; // Velocidad reducida para caída suave (aprox 1px/frame a 16px font)
    }
  }

  let animationId: number;
  function animate() {
    draw();
    animationId = requestAnimationFrame(animate);
  }

  animate();

  window.addEventListener('resize', () => {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    // Re-calculate columns if needed, but simple is better
  });
</script>
