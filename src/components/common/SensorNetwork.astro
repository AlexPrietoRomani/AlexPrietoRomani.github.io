<div class="sensor-network-container">
  <canvas id="sensor-network"></canvas>
  <div class="overlay"></div>
</div>

<style>
  .sensor-network-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: var(--bg-main);
    overflow: hidden;
  }

  #sensor-network {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, var(--bg-main) 100%);
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('sensor-network') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  let width = canvas.width = window.innerWidth;
  let height = canvas.height = window.innerHeight;

  const CONNECTION_DISTANCE = 150;
  
  class Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;

    constructor() {
      this.x = Math.random() * width;
      this.y = Math.random() * height;
      // Muy baja velocidad para flotación orgánica
      this.vx = (Math.random() - 0.5) * 0.5;
      this.vy = (Math.random() - 0.5) * 0.5;
      this.radius = Math.random() * 1.5 + 1; // 1px a 2.5px
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;

      // Rebotar en los bordes suavemente
      if (this.x < 0 || this.x > width) this.vx *= -1;
      if (this.y < 0 || this.y > height) this.vy *= -1;
    }

    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(16, 185, 129, 0.6)'; // #10b981 con opacidad
      ctx.fill();
    }
  }

  let particles: Particle[] = [];

  function initParticles() {
    particles = [];
    // Limitar nodos según el ancho (menos en móviles)
    const numberOfParticles = Math.min(Math.floor((width * height) / 12000), 100);
    
    for (let i = 0; i < numberOfParticles; i++) {
      particles.push(new Particle());
    }
  }

  function animate() {
    ctx.clearRect(0, 0, width, height);

    for (let i = 0; i < particles.length; i++) {
      particles[i].update();
      particles[i].draw();

      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < CONNECTION_DISTANCE) {
          ctx.beginPath();
          // La opacidad de la línea depende de la distancia
          const opacity = 1 - (distance / CONNECTION_DISTANCE);
          ctx.strokeStyle = `rgba(52, 211, 153, ${opacity * 0.3})`; // #34d399
          ctx.lineWidth = 1;
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    requestAnimationFrame(animate);
  }

  initParticles();
  animate();

  window.addEventListener('resize', () => {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    initParticles();
  });
</script>
