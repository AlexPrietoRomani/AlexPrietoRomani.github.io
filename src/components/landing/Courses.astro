---
import { siteData } from '../../data/siteData';

const { courses } = siteData;
---

<section id="courses" class="section courses-section" data-section>
  <div class="container">
    <h2 class="section-title" id="courses-title">{courses.title.es}</h2>
    <p class="section-intro" id="courses-intro">
      {courses.intro.es}
    </p>
    
    <div class="courses-actions">
      <a 
        href={courses.mainButton.href} 
        target="_blank"
        class="platform-btn"
        id="courses-main-btn"
      >
        <span class="icon">{courses.mainButton.icon}</span> {courses.mainButton.text.es}
      </a>
    </div>

    <div class="course-grid">
      {courses.cards.map((course, index) => (
        <a href={course.href} target="_blank" class="course-card" style={`--card-image: url('${course.image}');`}>
          <div class="course-card-overlay"></div>
          <div class="course-card-body">
            <span class="course-card-kicker" data-index={index}>{course.kicker.es}</span>
            <h3 class="course-card-title" data-index={index}>{course.title.es}</h3>
            <p class="course-card-meta" data-index={index}>{course.meta.es}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .courses-actions {
    display: flex;
    justify-content: center;
    margin: 2rem 0 3rem;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: var(--agro-green);
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 10px 25px rgba(47, 133, 90, 0.4);
    transition: all 0.3s ease;
  }

  .platform-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(47, 133, 90, 0.5);
    background: var(--agro-accent);
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .course-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    height: 280px;
    background-image: linear-gradient(to bottom, transparent, rgba(0,0,0,0.8)), var(--card-image);
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    text-decoration: none;
    border: 1px solid var(--border-main);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .course-card:hover {
    transform: scale(1.02);
    border-color: var(--agro-accent);
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .course-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 10, 8, 0.9) 0%, transparent 70%);
    pointer-events: none;
  }

  .course-card-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .course-card-kicker {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--agro-accent);
  }

  .course-card-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
  }

  .course-card-meta {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';
  import { siteData } from '../../data/siteData';

  $lang.subscribe(lang => {
    const title = document.getElementById('courses-title');
    const intro = document.getElementById('courses-intro');
    const mainBtn = document.getElementById('courses-main-btn');

    if (title) title.textContent = siteData.courses.title[lang];
    if (intro) intro.textContent = siteData.courses.intro[lang];
    if (mainBtn) {
       const icon = siteData.courses.mainButton.icon;
       const text = siteData.courses.mainButton.text[lang];
       mainBtn.innerHTML = `<span class="icon">${icon}</span> ${text}`;
    }

    document.querySelectorAll('.course-card-kicker').forEach((el, i) => {
      el.textContent = siteData.courses.cards[i].kicker[lang];
    });
    document.querySelectorAll('.course-card-title').forEach((el, i) => {
      el.textContent = siteData.courses.cards[i].title[lang];
    });
    document.querySelectorAll('.course-card-meta').forEach((el, i) => {
      el.textContent = siteData.courses.cards[i].meta[lang];
    });
  });
</script>
