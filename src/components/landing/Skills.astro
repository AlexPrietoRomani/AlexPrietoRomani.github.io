---
import { siteData } from '../../data/siteData';

const { skills } = siteData;
---

<section id="tech" class="section skills-section" data-section>
  <div class="container">
    <h2 class="section-title" id="skills-title">{siteData.lang === 'en' ? 'Technologies & Tools' : 'Tecnologías y herramientas'}</h2>
    
    <div class="skills-grid">
      {skills.map((category, catIndex) => (
        <div class="skill-category-card">
          <h3 class="category-title" data-cat-index={catIndex}>{category.category.es}</h3>
          <div class="tech-list">
            {category.items.map(tech => (
              <div class="tech-item" title={tech.name}>
                {tech.image ? (
                  <img src={tech.image} alt={tech.name} class="tech-img" />
                ) : (
                  <i class={`tech-icon ${tech.icon}`}></i>
                )}
                <span class="tech-name">{tech.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .skill-category-card {
    background: var(--bg-surface);
    border-radius: 24px;
    padding: 2rem;
    border: 1px solid var(--border-main);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .skill-category-card:hover {
    transform: translateY(-5px);
    border-color: var(--agro-accent);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .category-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--agro-accent);
    border-bottom: 1px solid var(--border-main);
    padding-bottom: 0.75rem;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 12px;
    background-color: var(--bg-surface-2);
    width: 90px;
    height: 100px;
    justify-content: center;
    transition: all 0.2s;
    border: 1px solid transparent;
  }
  
  .tech-item:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-highlight);
    transform: scale(1.05);
  }

  .tech-icon {
    font-size: 2.5rem;
  }

  .tech-img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .tech-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.2;
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';
  import { siteData } from '../../data/siteData';

  $lang.subscribe(lang => {
    const title = document.getElementById('skills-title');
    if (title) title.textContent = lang === 'es' ? 'Tecnologías y herramientas' : 'Technologies & Tools';

    document.querySelectorAll('.category-title').forEach((el, i) => {
      const catIndex = el.getAttribute('data-cat-index');
      if (catIndex !== null) {
        el.textContent = siteData.skills[parseInt(catIndex)].category[lang];
      }
    });
  });
</script>
