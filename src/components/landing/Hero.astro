---
import { siteData } from '../../data/siteData';

const { hero } = siteData;
---

<section id="home" class="hero-section">
  <div class="hero-container">
    <!-- Profile Avatar with Ring -->
    <div class="hero-avatar animate-fade-in">
       <div class="avatar-ring">
         <div class="avatar-inner">
           <img src={hero.image} alt={hero.title} class="profile-img" />
         </div>
       </div>
    </div>
    
    <div class="hero-content animate-fade-in delay-100">
      <p class="greeting" id="hero-greeting">Hola, soy</p>
      <h1 class="name">{hero.title}</h1>
      <p class="bio" id="hero-bio">{hero.subtitle.es}</p>
      
      <div class="hero-actions">
        <a href={hero.cta.resume.href} target="_blank" class="resume-btn" id="hero-resume-btn" aria-label="Descargar Currículum Vitae de Alex Prieto Romani">
          {hero.cta.resume.text.es}
        </a>
      </div>
      
      <div class="hero-social">
        <a href={hero.cta.primary.href} target="_blank" aria-label="LinkedIn" class="social-link">
          <i class="devicon-linkedin-plain"></i>
        </a>
        <a href={hero.cta.secondary.href} target="_blank" aria-label="GitHub" class="social-link">
          <i class="devicon-github-original"></i>
        </a>
        <a href={`mailto:${siteData.contact.email}`} aria-label="Email" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
        <a href={`https://wa.me/?text=Hola%20Alex`} target="_blank" aria-label="WhatsApp" class="social-link">
           <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 1rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    max-width: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.5rem;
    position: relative;
    z-index: 10;
  }

  /* Avatar with Glowing Ring */
  .hero-avatar {
    position: relative;
  }

  .avatar-ring {
    width: 160px;
    height: 160px;
    padding: 4px;
    background: linear-gradient(135deg, var(--agro-green), var(--agro-accent));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(72, 187, 120, 0.3);
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    background: var(--bg-main);
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content Styles */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .greeting {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--agro-accent);
    margin: 0;
  }

  .name {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1;
    margin: 0;
    background: linear-gradient(to bottom, #fff, #cbd5e1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bio {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.6;
    margin: 0;
  }

  /* Buttons & Socials */
  .hero-actions {
    margin-top: 1rem;
  }

  .resume-btn {
    display: inline-block;
    padding: 0.8rem 2.5rem;
    background: transparent;
    color: var(--text-inverse);
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .resume-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .hero-social {
    display: flex;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .social-link {
    color: var(--text-muted);
    font-size: 1.5rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-link:hover {
    color: var(--text-main);
    transform: translateY(-3px);
  }

  @media (max-width: 640px) {
    .avatar-ring {
      width: 130px;
      height: 130px;
    }
    .bio {
      font-size: 1rem;
    }
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';
  import { siteData } from '../../data/siteData';

  $lang.subscribe(lang => {
    const greeting = document.getElementById('hero-greeting');
    const bio = document.getElementById('hero-bio');
    const resumeBtn = document.getElementById('hero-resume-btn');

    if (greeting) greeting.textContent = lang === 'es' ? 'Hola, soy' : "Hello, I'm";
    if (bio) bio.textContent = siteData.hero.subtitle[lang];
    if (resumeBtn) {
      resumeBtn.textContent = siteData.hero.cta.resume.text[lang];
      resumeBtn.setAttribute('aria-label', lang === 'es' ? 'Descargar Currículum Vitae de Alex Prieto Romani' : 'Download CV of Alex Prieto Romani');
    }
  });
</script>
