---
import { siteData } from '../../data/siteData';
const { education } = siteData;
---

<section id="education" class="section education-section" data-section>
  <div class="container">
    <h2 class="section-title" id="education-title">{siteData.lang === 'en' ? 'Education' : 'Educación'}</h2>
    
    <div class="timeline">
      <div class="timeline-line"></div>
      
      {education.map((item, index) => (
        <div class="timeline-item left">
          <div class="timeline-dot">
            <div class="dot-inner"></div>
          </div>
          
          <div class="timeline-content">
            <span class="year" data-edu-year-index={index}>{item.year.es}</span>
            <h3 class="role" data-edu-role-index={index}>{item.title.es}</h3>
            <h4 class="company" data-edu-company-index={index}>{item.company.es}</h4>
            <p class="description" data-edu-desc-index={index}>{item.description.es}</p>
            <div class="type-badge">🎓</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .education-section {
    position: relative;
    padding: 2rem 0 6rem;
  }

  .timeline {
    position: relative;
    max-width: 900px;
    margin: 3rem auto 0;
    padding: 2rem 0;
  }

  .timeline-line {
    position: absolute;
    left: 30px;
    top: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(to bottom, 
      transparent, 
      var(--agro-accent) 15%, 
      var(--agro-accent) 85%, 
      transparent
    );
    opacity: 0.3;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    padding-left: 70px;
  }

  .timeline-dot {
    position: absolute;
    left: 30px;
    top: 2rem;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    background: var(--bg-main);
    border: 2px solid var(--border-main);
    border-radius: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s ease;
  }

  .timeline-item.active .timeline-dot {
    border-color: var(--agro-accent);
    box-shadow: 0 0 15px var(--agro-accent);
  }

  .dot-inner {
    width: 8px;
    height: 8px;
    background: var(--border-main);
    border-radius: 50%;
    transition: all 0.4s ease;
  }

  .timeline-item.active .dot-inner {
    background: var(--agro-accent);
    box-shadow: 0 0 10px var(--agro-accent);
  }

  .timeline-content {
    position: relative;
    width: 100%;
    padding: 2rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-main);
    border-radius: 24px;
    transition: all 0.4s ease;
    opacity: 0.5;
    transform: translateY(20px);
    text-align: left;
  }

  .timeline-item.active .timeline-content {
    opacity: 1;
    transform: translateY(0);
    border-color: var(--agro-accent);
  }

  .timeline-item:hover .timeline-content {
    border-color: var(--agro-accent);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .year {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--agro-accent);
    margin-bottom: 0.5rem;
  }

  .role {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .type-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 1.2rem;
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';
  import { siteData } from '../../data/siteData';

  $lang.subscribe(lang => {
    const title = document.getElementById('education-title');
    if (title) title.textContent = lang === 'es' ? 'Educación' : 'Education';

    document.querySelectorAll('[data-edu-year-index]').forEach(el => {
      const idx = el.getAttribute('data-edu-year-index');
      if (idx !== null) el.textContent = siteData.education[parseInt(idx)].year[lang];
    });

    document.querySelectorAll('[data-edu-role-index]').forEach(el => {
      const idx = el.getAttribute('data-edu-role-index');
      if (idx !== null) el.textContent = siteData.education[parseInt(idx)].title[lang];
    });

    document.querySelectorAll('[data-edu-company-index]').forEach(el => {
      const idx = el.getAttribute('data-edu-company-index');
      if (idx !== null) el.textContent = siteData.education[parseInt(idx)].company[lang];
    });

    document.querySelectorAll('[data-edu-desc-index]').forEach(el => {
      const idx = el.getAttribute('data-edu-desc-index');
      if (idx !== null) el.textContent = siteData.education[parseInt(idx)].description[lang];
    });
  });

  // Scroll illumination logic
  const observerOptions = { threshold: 0.3 };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.education-section .timeline-item').forEach(item => {
    observer.observe(item);
  });
</script>
