---
import { siteData } from '../../data/siteData';
const { skills } = siteData;
---

<section id="tech-stack" class="section tech-stack-section" data-section>
  <div class="container">
    <h2 class="section-title" id="tech-title">{siteData.lang === 'en' ? 'Technical Stack' : 'Stack Tecnológico'}</h2>
    <p class="section-intro" id="tech-intro">
      {siteData.lang === 'en' ? 'Core technologies and tools I use to solve complex agricultural problems through data.' : 'Tecnologías y herramientas clave que utilizo para resolver problemas agrícolas complejos mediante datos.'}
    </p>

    <div class="tech-grid">
      {skills.map((group, groupIndex) => (
        <div class="tech-group">
          <h3 class="group-title" data-group-index={groupIndex}>{group.category[siteData.lang === 'en' ? 'en' : 'es']}</h3>
          <div class="tech-items">
            {group.items.map((skill) => (
              <div class="tech-item">
                <div class="tech-info">
                  {skill.icon ? (
                    <i class={`${skill.icon} tech-icon`}></i>
                  ) : (
                    <img src={skill.image} alt={skill.name} class="tech-image-icon" />
                  )}
                  <span class="tech-name">{skill.name}</span>
                </div>
                <div class="tech-level">
                  {[1, 2, 3].map((star) => (
                    <div class={`star ${star <= skill.level ? 'filled' : ''}`}></div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-stack-section {
    padding: 8rem 0;
    position: relative;
    z-index: 1;
  }

  .section-intro {
    background: rgba(10, 21, 17, 0.8);
    backdrop-filter: blur(8px);
    padding: 1.5rem 2rem;
    border-radius: 20px;
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: var(--text-main) !important;
    font-weight: 500;
    max-width: 800px;
    margin: 0 auto 4rem auto;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3rem;
    align-items: start;
  }

  .tech-group {
    background: rgba(13, 25, 21, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    padding: 2.5rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: visible; /* Allow shadow and glow to show */
  }

  .tech-group:hover {
    border-color: var(--agro-accent);
    background: rgba(16, 185, 129, 0.05);
    transform: translateY(-10px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .group-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--agro-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(16, 185, 129, 0.4), transparent);
  }

  .tech-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tech-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
  }

  .tech-item:hover {
    transform: translateX(10px);
  }

  .tech-info {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .tech-icon {
    font-size: 1.6rem;
    width: 32px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--agro-accent);
  }

  .tech-image-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .tech-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .tech-level {
    display: flex;
    gap: 8px;
  }

  .star {
    width: 18px;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    transition: all 0.4s ease;
  }

  .star.filled {
    background: var(--agro-accent);
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.7);
  }

  @media (max-width: 1024px) {
    .tech-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .tech-grid {
      grid-template-columns: 1fr;
    }
    .tech-group {
      padding: 2.5rem 2rem;
    }
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';
  import { siteData } from '../../data/siteData';

  $lang.subscribe(lang => {
    const title = document.getElementById('tech-title');
    const intro = document.getElementById('tech-intro');
    if (title) title.textContent = lang === 'es' ? 'Stack Tecnológico' : 'Technical Stack';
    if (intro) intro.textContent = lang === 'es' 
      ? 'Tecnologías y herramientas clave que utilizo para resolver problemas agrícolas complejos mediante datos.' 
      : 'Core technologies and tools I use to solve complex agricultural problems through data.';

    document.querySelectorAll('.group-title').forEach((el, i) => {
      const idx = el.getAttribute('data-group-index');
      if (idx !== null) {
         el.textContent = siteData.skills[parseInt(idx)].category[lang];
      }
    });
  });
</script>
