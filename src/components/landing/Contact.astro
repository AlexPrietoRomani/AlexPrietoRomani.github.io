---
import { siteData } from '../../data/siteData';

const { contact } = siteData;
---

<section id="contact" class="section contact-section" data-section>
  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <h2 class="section-title" id="contact-title">{siteData.lang === 'en' ? 'Get in Touch' : 'Contáctame'}</h2>
        <p class="contact-intro" id="contact-intro">
          {siteData.lang === 'en' 
            ? 'Interested in collaborating, learning about my courses, or inviting me to a project? Let’s connect!' 
            : '¿Quieres colaborar, conocer más sobre mis cursos o invitarme a un proyecto? ¡Hablemos!'}
        </p>
      </div>
      
      <div class="contact-methods">
        <div class="contact-card">
          <div class="method">
            <div class="method-icon">
              <i class="devicon-google-plain"></i>
            </div>
            <div class="method-details">
              <span class="method-label" data-key="email">{siteData.lang === 'en' ? 'Email' : 'Correo'}</span>
              <a href={`mailto:${contact.email}`} class="method-link">{contact.email}</a>
            </div>
          </div>
          <div class="method">
            <div class="method-icon">
              <i class="devicon-linkedin-plain"></i>
            </div>
            <div class="method-details">
              <span class="method-label" data-key="linkedin">LinkedIn</span>
              <a href={contact.linkedinUrl} target="_blank" class="method-link">alex-prieto-romani</a>
            </div>
          </div>
          <div class="method">
            <div class="method-icon">
              <i class="devicon-github-original"></i>
            </div>
            <div class="method-details">
              <span class="method-label" data-key="github">GitHub</span>
              <a href={contact.githubUrl} target="_blank" class="method-link">AlexPrietoRomani</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 4rem;
    align-items: center;
  }

  .contact-info {
    text-align: left;
  }

  .contact-intro {
    font-size: 1.1rem;
    color: #1a202c !important;
    opacity: 0.9;
    line-height: 1.7;
    margin-top: 1.5rem;
    max-width: 500px;
  }

  .contact-methods {
    width: 100%;
  }

  .contact-card {
    background: rgba(13, 25, 21, 0.95);
    backdrop-filter: blur(12px);
    border-radius: 32px;
    padding: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .method {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .method-icon {
    width: 48px;
    height: 48px;
    background: rgba(16, 185, 129, 0.1);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--agro-accent);
    font-size: 1.5rem;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .method:hover .method-icon {
    background: var(--agro-accent);
    color: #ffffff;
    transform: scale(1.1);
  }

  .method-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .method-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--agro-accent);
  }

  .method-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    transition: all 0.2s;
    word-break: break-all;
  }

  .method-link:hover {
    color: var(--agro-accent);
  }

  @media (max-width: 768px) {
    .contact-wrapper {
      text-align: center;
      gap: 3rem;
    }
    .contact-info {
      text-align: center;
    }
    .contact-intro {
      margin-left: auto;
      margin-right: auto;
    }
    .method {
      text-align: left;
    }
    .contact-card {
      padding: 2rem;
    }
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';

  $lang.subscribe(lang => {
    const title = document.getElementById('contact-title');
    const intro = document.getElementById('contact-intro');
    if (title) title.textContent = lang === 'es' ? 'Contáctame' : 'Get in Touch';
    if (intro) intro.textContent = lang === 'es' 
      ? '¿Quieres colaborar, conocer más sobre mis cursos o invitarme a un proyecto? ¡Hablemos!' 
      : 'Interested in collaborating, learning about my courses, or inviting me to a project? Let’s connect!';

    const emailLabel = document.querySelector('[data-key="email"]');
    if (emailLabel) emailLabel.textContent = lang === 'es' ? 'Correo' : 'Email';
  });
</script>
