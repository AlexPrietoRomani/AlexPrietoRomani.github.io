---
import { siteData } from '../../data/siteData';

const { contact } = siteData;
---

<section id="contact" class="section contact-section" data-section>
  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <h2 class="section-title" id="contact-title">{siteData.lang === 'en' ? 'Get in Touch' : 'Contáctame'}</h2>
        <p class="contact-intro" id="contact-intro">
          {siteData.lang === 'en' 
            ? 'Interested in collaborating, learning about my courses, or inviting me to a project? Let’s connect!' 
            : '¿Quieres colaborar, conocer más sobre mis cursos o invitarme a un proyecto? ¡Hablemos!'}
        </p>
      </div>
      
      <div class="contact-methods">
        <div class="contact-card">
          <div class="method">
            <span class="method-label" data-key="email">{siteData.lang === 'en' ? 'Email' : 'Correo'}</span>
            <a href={`mailto:${contact.email}`} class="method-link">{contact.email}</a>
          </div>
          <div class="method">
            <span class="method-label" data-key="linkedin">LinkedIn</span>
            <a href={contact.linkedinUrl} target="_blank" class="method-link">{contact.linkedin}</a>
          </div>
          <div class="method">
            <span class="method-label" data-key="github">GitHub</span>
            <a href={contact.githubUrl} target="_blank" class="method-link">{contact.github}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
    align-items: center;
  }

  .contact-info {
    text-align: left;
  }

  .contact-intro {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .contact-methods {
    width: 100%;
  }

  .contact-card {
    background: var(--bg-surface);
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid var(--border-main);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  .method {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .method-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--agro-accent);
  }

  .method-link {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s;
    word-break: break-all;
  }

  .method-link:hover {
    color: var(--agro-accent);
  }

  @media (max-width: 768px) {
    .contact-wrapper {
      text-align: center;
      gap: 2rem;
    }
    .contact-info {
      text-align: center;
    }
    .contact-card {
      padding: 1.5rem;
    }
  }
</style>

<script>
  import { $lang } from '../../stores/langStore';

  $lang.subscribe(lang => {
    const title = document.getElementById('contact-title');
    const intro = document.getElementById('contact-intro');
    if (title) title.textContent = lang === 'es' ? 'Contáctame' : 'Get in Touch';
    if (intro) intro.textContent = lang === 'es' 
      ? '¿Quieres colaborar, conocer más sobre mis cursos o invitarme a un proyecto? ¡Hablemos!' 
      : 'Interested in collaborating, learning about my courses, or inviting me to a project? Let’s connect!';

    const emailLabel = document.querySelector('[data-key="email"]');
    if (emailLabel) emailLabel.textContent = lang === 'es' ? 'Correo' : 'Email';
  });
</script>
